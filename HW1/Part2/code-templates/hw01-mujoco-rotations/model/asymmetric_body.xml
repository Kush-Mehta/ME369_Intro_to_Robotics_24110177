<?xml version="1.0"?>
<!--
  asymmetric_body.xml

  A deliberately asymmetric free body (a little "dart": fuselage +
  nose + two fins, each a different color) so that its orientation
  is visually unambiguous from any viewing angle -- rotate it and
  you can immediately tell it moved, and by how much.

  Also includes RGB = XYZ axis markers for both the body frame
  (moves with the dart) and a fixed space frame at the origin, so
  Task 1 (current-frame vs. fixed-frame composition) is easy to
  read directly off the render: red=x, green=y, blue=z.
-->
<mujoco model="asymmetric_body">
  <compiler angle="radian"/>
  <option gravity="0 0 0" timestep="0.005"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.95 0.95 0.98" rgb2="0.6 0.6 0.7" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.95 0.95 0.95" width="300" height="300"/>
    <material name="grid_mat" texture="grid" texrepeat="6 6" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid_mat"/>

    <!-- Fixed SPACE frame axes, drawn at the origin (faded colors) -->
    <site name="space_x_axis" type="cylinder" fromto="0 0 1 0.5 0 1" size="0.006" rgba="1 0.3 0.3 0.35"/>
    <site name="space_y_axis" type="cylinder" fromto="0 0 1 0 0.5 1" size="0.006" rgba="0.3 1 0.3 0.35"/>
    <site name="space_z_axis" type="cylinder" fromto="0 0 1 0 0 1.5" size="0.006" rgba="0.3 0.3 1 0.35"/>

    <body name="asym_body" pos="0 0 1">
      <freejoint name="root"/>
      <!-- fuselage -->
      <geom name="fuselage" type="box" size="0.3 0.07 0.07" rgba="0.75 0.2 0.2 1" mass="1.0"/>
      <!-- nose (marks +x of the BODY frame unambiguously) -->
      <geom name="nose" type="sphere" size="0.09" pos="0.35 0 0" rgba="0.15 0.55 0.9 1" mass="0.2"/>
      <!-- two different fins so the body has no symmetry axis -->
      <geom name="fin_top" type="box" size="0.05 0.02 0.14" pos="-0.2 0 0.12" rgba="0.2 0.75 0.25 1" mass="0.1"/>
      <geom name="fin_side" type="box" size="0.05 0.18 0.02" pos="-0.2 0.14 -0.02" rgba="0.9 0.7 0.1 1" mass="0.1"/>

      <!-- BODY frame axes (solid colors, move with the body) -->
      <site name="body_x_axis" type="cylinder" fromto="0 0 0 0.45 0 0" size="0.008" rgba="1 0 0 1"/>
      <site name="body_y_axis" type="cylinder" fromto="0 0 0 0 0.45 0" size="0.008" rgba="0 1 0 1"/>
      <site name="body_z_axis" type="cylinder" fromto="0 0 0 0 0 0.45" size="0.008" rgba="0 0 1 1"/>
    </body>
  </worldbody>
</mujoco>
