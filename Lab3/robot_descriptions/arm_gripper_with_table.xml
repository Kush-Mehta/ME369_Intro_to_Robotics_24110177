<mujoco model="robot_with_table">
  <!--
    Combined scene: HEAL arm + gripper + table + cube
    Edit TABLE_* and CUBE_* defaults below — they cascade everywhere.

    ┌─────────────────────────────────────────────────────┐
    │  PARAMETRIC TABLE — change these three values only  │
    │  TABLE_HALF_LEN : half-length along X    │
    │  TABLE_HALF_WID : half-width  along Y    │
    │  TABLE_HALF_HGT : half-height of the top slab       │
    │  LEG_RADIUS     : half-size of each square leg      │
    └─────────────────────────────────────────────────────┘

    Original table:  length 0.80 m, width 0.60 m, height 0.40 m
    This scene    :  length 0.80 m, width 0.60 m, height 0.20 m  (half height)
                     same orientation as Franka → long axis along X

    Table body is placed at  pos="0.0 0.55 0"  so the top surface sits
    at  z = LEG_HEIGHT + TABLE_HALF_HGT  = 0.16 + 0.02 = 0.18 m
  -->

  <compiler angle="radian" meshdir="heal_meshes/"/>
  <option gravity="0 0 -9.81" timestep="0.002" cone="elliptic" impratio="10"/>

  <!-- ══════════════════════════════════════════════════════════
       TABLE PARAMETERS  ← edit here, nowhere else
       ══════════════════════════════════════════════════════════ -->
  <default>
    <!-- Table geometry (half-sizes in metres) -->
    <default class="table_top">
      <!-- size: half_x=TABLE_HALF_LEN  half_y=TABLE_HALF_WID  half_z=TABLE_HALF_HGT -->
      <!-- Current values: half_x=0.40  half_y=0.30  half_z=0.02 -->
    </default>

    <!-- Robotiq 2F-85 gripper defaults — copied from
         robot_descriptions/robotiq_2f85_v4/2f85.xml so the finger
         dynamics (solimp/solref, pad friction, spring-loaded 4-bar
         linkage) exactly match the tuned, working gripper model
         instead of an ad-hoc placeholder. Classes are prefixed
         "grip_" to avoid any clash with other default classes. -->
    <default class="grip">
      <general biastype="affine"/>
      <joint axis="0 0 1"/>
      <default class="grip_driver">
        <joint range="0 1.10" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="grip_follower">
        <joint range="-0.872664 0.9" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="grip_spring_link">
        <joint range="-0.29670597283 0.9" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="grip_coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="grip_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="black"/>
      </default>
      <default class="grip_collision">
        <geom type="mesh" group="3"/>
        <default class="grip_pad1">
          <geom mass="0.00175" type="box" pos="0.043258 0 0.12" size="0.002 0.011 0.009375" friction="0.7"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="grip_pad2">
          <geom mass="0.00175" type="box" pos="0.043258 0 0.13875" size="0.002 0.011 0.009375" friction="0.6"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>
  <!-- Python-readable parameter block — used by launch scripts
       TABLE_HALF_LEN  = 0.40   # half-length along X
       TABLE_HALF_WID  = 0.30   # half-width  along Y
       TABLE_HALF_HGT  = 0.02   # half-thickness of top slab
       TABLE_LEG_HALF  = 0.03   # half-size of each leg (square cross-section)
       TABLE_LEG_HEIGHT= 0.16   # leg height (centre at LEG_HEIGHT/2)
       TABLE_BODY_POS_X= 0.00   # table body X in world
       TABLE_BODY_POS_Y= 0.55   # table body Y in world (robot faces +Y)
       TABLE_TOP_Z     = 0.18   # = TABLE_LEG_HEIGHT + TABLE_HALF_HGT
       CUBE_HALF       = 0.02   # half-size of pick cube
  -->

  <asset>
    <!-- Ground / environment -->
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.18 0.27 0.36" rgb2="0.12 0.18 0.25" width="400" height="400"/>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.35 0.55 0.75" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <material name="ground_mat"  texture="grid" texrepeat="4 4" reflectance="0.15"/>
    <material name="groundplane" texture="grid" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <!-- Table -->
    <material name="table_mat" rgba="0.72 0.58 0.42 1" specular="0.4" shininess="0.3"/>
    <material name="leg_mat"   rgba="0.55 0.42 0.28 1"/>
    <material name="cube_mat"  rgba="0.90 0.25 0.20 1" specular="0.6" shininess="0.5"/>
    <!-- Robot mesh assets -->
    <material name="black" rgba="0.08 0.08 0.08 1"/>
    <material name="metal" rgba="0.7 0.7 0.7 1" specular="0.5" shininess="1.0"/>
    <material name="arm"   rgba="0.75 0.75 0.75 1"/>
    <mesh name="base_link"     file="base_link.STL"/>
    <mesh name="link1"         file="link_1.STL"/>
    <mesh name="link2"         file="link_2.STL"/>
    <mesh name="link3"         file="link_3.STL"/>
    <mesh name="link4"         file="link_4.STL"/>
    <mesh name="link5"         file="link_5.STL"/>
    <mesh name="end_effector"  file="end_effector.STL"/>

    <!-- Robotiq 2F-85 gripper meshes (real STL geometry, not boxes) -->
    <mesh name="grip_base"          file="../robotiq_2f85_v4/assets/base.stl"          scale="0.001 0.001 0.001"/>
    <mesh name="grip_base_coupling" file="../robotiq_2f85_v4/assets/base_coupling.stl" scale="0.001 0.001 0.001"/>
    <mesh name="grip_shell"         file="../robotiq_2f85_v4/assets/c-a01-85-open.stl" scale="0.001 0.001 0.001"/>
    <mesh name="grip_driver"        file="../robotiq_2f85_v4/assets/driver.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="grip_coupler"       file="../robotiq_2f85_v4/assets/coupler.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="grip_spring_link"   file="../robotiq_2f85_v4/assets/spring_link.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="grip_follower"      file="../robotiq_2f85_v4/assets/follower.stl"      scale="0.001 0.001 0.001"/>
    <mesh name="grip_tongue"        file="../robotiq_2f85_v4/assets/tongue.stl"        scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>

    <light name="overhead" directional="true"
           diffuse=".55 .55 .55" specular=".15 .15 .15"
           pos="0 0 5" dir="0 0 -1" castshadow="false"/>
    <light name="fill" directional="true"
           diffuse=".30 .30 .30" specular=".05 .05 .05"
           pos="2 0 2" dir="-1 0 -0.5" castshadow="false"/>

    <geom name="ground" type="plane" size="0 0 1" pos="0 0 0"
          material="ground_mat" condim="1"/>

    <camera name="scene_3d_view" pos="1.2 -0.8 1.0" xyaxes="0.7 0.7 0 -0.4 0.4 0.8"/>

    <!-- ══════════════════════════════════════════════════════════
         HEAL ARM  (base at world origin)
         Joint limits all ±π  — consistent with workspace_generator.py
         ══════════════════════════════════════════════════════════ -->
    <body name="base_link" pos="0.0 0 0" euler="0 0 0">
      <geom name="base_link_visual"    type="mesh" mesh="base_link"
            group="1" contype="0" conaffinity="0" material="arm"/>
      <geom name="base_link_collision" type="mesh" mesh="base_link"
            group="0" contype="0" conaffinity="0"/>

      <body name="link_1" pos="0 0 0.171">
        <inertial pos="-12.54E-03 -0.04E-03 111.27E-03"
                  quat="0.704455 -0.0304055 0.0162858 0.70891"
                  mass="7.92" diaginertia="0.00490984 0.00426023 0.00389513"/>
        <joint name="joint_1" pos="0 0 0" axis="0 0 1"
               range="-3.14159 3.14159" damping="55" frictionloss="0.1"
               actuatorfrcrange="-10000 10000"/>
        <geom name="link_1_visual"    type="mesh" mesh="link1"
              group="1" contype="0" conaffinity="0" material="arm"/>
        <geom name="link_1_collision" type="mesh" mesh="link1" group="0"/>

        <body name="link_2" pos="0 0.0875 0.1498" quat="0.707105 0.707108 0 0">
          <inertial pos="-0.00017021 0.1561 -0.016973"
                    quat="0.499892 0.50026 -0.499813 0.500035"
                    mass="1.24" diaginertia="0.0097684 0.0086581 0.0014536"/>
          <joint name="joint_2" pos="0 0 0" axis="0 0 -1"
                 range="-3.14159 3.14159" damping="55" frictionloss="0.1"
                 actuatorfrcrange="-10000 10000"/>
          <geom name="link_2_visual"    type="mesh" mesh="link2"
                group="1" contype="0" conaffinity="0" material="arm"/>
          <geom name="link_2_collision" type="mesh" mesh="link2" group="0"/>

          <body name="link_3" pos="0 0.3 0" euler="0 0 -1.57">
            <inertial pos="-7.5516e-07 0 0.073251"
                      quat="0.495149 0.509997 -0.506629 0.487912"
                      mass="5.57" diaginertia="0.0048786 0.00425304 0.00369796"/>
            <joint name="joint_3" pos="0 0 0" axis="0 0 1"
                   range="-3.14159 3.14159" damping="55" frictionloss="0.1"
                   actuatorfrcrange="-10000 10000"/>
            <geom name="link_3_visual"    type="mesh" mesh="link3"
                  group="1" contype="0" conaffinity="0" material="arm"/>
            <geom name="link_3_collision" type="mesh" mesh="link3" group="0"/>

            <body name="link_4" pos="0 0.1593 0.0875" euler="-1.57 0 0">
              <inertial pos="1.3303e-05 0.06 0.10412"
                        quat="0.313668 0.63349 -0.634256 0.313086"
                        mass="1.9" diaginertia="0.00162547 0.0014257 0.00104183"/>
              <joint name="joint_4" pos="0 0 0" axis="0 0 1"
                     range="-3.14159 3.14159" damping="55" frictionloss="0.1"
                     actuatorfrcrange="-10000 10000"/>
              <geom name="link_4_visual"    type="mesh" mesh="link4"
                    group="1" contype="0" conaffinity="0" material="arm"/>
              <geom name="link_4_collision" type="mesh" mesh="link4" group="0"/>

              <body name="link_5" pos="0 0.03185 0.16105" euler="0.50951 0 1.57">
                <inertial pos="-5.6194e-05 -0.046 0.059696"
                          quat="0.457117 0.537094 0.438555 0.556994"
                          mass="1.78" diaginertia="0.000913478 0.000827593 0.000774169"/>
                <joint name="joint_5" pos="0 0 0" axis="0 0 1"
                       range="-3.14159 3.14159" damping="55" frictionloss="0.1"
                       actuatorfrcrange="-10000 10000"/>
                <geom name="link_5_visual"    type="mesh" mesh="link5"
                      group="1" contype="0" conaffinity="0" material="arm"/>
                <geom name="link_5_collision" type="mesh" mesh="link5" group="0"/>

                <!-- End-effector flange -->
                <body name="end_effector" pos="0 -0.1227 0.0654"
                      quat="0.707105 0.707108 0 0">
                  <body name="right_hand" pos="0.0 0.0 0.0" quat="1 0 0 0">
                    <camera mode="fixed" name="right_eye_in_hand"
                            pos="0.05 0 0" quat="0.5 0.5 -0.5 -0.5" fovy="75"/>
                  </body>
                  <inertial pos="7.0245e-06 -0.00022138 -0.016847"
                            quat="-0.0128774 0.707029 0.00995758 0.706998"
                            mass="0.001"
                            diaginertia="0.000326122 0.000191249 0.000189678"/>
                  <joint name="joint_6" pos="0 0 0" axis="0 0 -1"
                         range="-3.14159 3.14159" damping="55" frictionloss="0.1"
                         actuatorfrcrange="-10000 10000"/>
                  <site name="right_center" pos="0 0 0" size="0.01"
                        rgba="1 0.3 0.3 1" group="1"/>
                  <geom name="end_effector_visual"    type="mesh" mesh="end_effector"
                        group="1" contype="0" conaffinity="0" material="arm"/>
                  <geom name="end_effector_collision" type="mesh" mesh="end_effector"
                        group="0"/>

                  <!-- ════════════════════════════════════════════════
                       Robotiq 2F-85 gripper, attached at the flange
                       (identity pose relative to end_effector, i.e.
                       coincident with the "right_center" site above).
                       Mirrors robot_descriptions/robotiq_2f85_v4/2f85.xml
                       ════════════════════════════════════════════════ -->
                  <body name="gripper_base" pos="0 0 0" quat="1 0 0 0" childclass="grip">
                    <site name="grasp_tcp" pos="0 0 0.0657045" size="0.006" rgba="0.1 1 0.2 1" group="1"/>
                    <inertial mass="0.777441" pos="7.77116e-05 8.42713e-05 0.0311656" quat="0.704758 -0.00373684 -0.00570287 0.709415"
                      diaginertia="0.000260285 0.000225381 0.000152708"/>
                    <geom class="grip_visual" pos="0 0 0.0108" quat="0 0 0 1" mesh="grip_base"/>
                    <geom class="grip_visual" pos="0 0 0.004" quat="1 -1 0 0" mesh="grip_base_coupling"/>
                    <geom class="grip_visual" pos="0 0 0.0108" quat="1 0 0 0" material="metal" mesh="grip_shell"/>
                    <geom class="grip_collision" pos="0 0 0.0108" quat="0 0 0 1" mesh="grip_base"/>

                    <!-- Left-hand side 4-bar linkage -->
                    <body name="left_driver" pos="-0.0306011 0.00475 0.0657045" quat="1 -1 0 0">
                      <inertial mass="0.00899563" pos="-0.0175297 0.00165308 -0.00469625" quat="-0.469642 0.469642 -0.528617 0.528617"
                        diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                      <joint name="left_driver_joint" class="grip_driver"/>
                      <geom class="grip_visual" pos="0.0306011 0.0549045 -0.0047" quat="1 1 0 0" material="metal" mesh="grip_driver"/>
                      <geom class="grip_collision" pos="0.0306011 0.0549045 -0.0047" quat="1 1 0 0" mesh="grip_driver"/>
                      <body name="left_coupler" pos="-0.0314249 0.00453223 -0.0102" quat="0 0 0 1">
                        <inertial mass="0.0140974" pos="0.00367747 0.01986 0.0055" quat="0.701447 -0.701447 0.0892884 -0.0892884"
                          diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                        <geom class="grip_visual" pos="-0.062026 -0.0503723 0.0055" quat="1 -1 0 0" mesh="grip_coupler"/>
                        <geom class="grip_collision" pos="-0.062026 -0.0503723 0.0055" quat="1 -1 0 0" mesh="grip_coupler"/>
                      </body>
                    </body>
                    <body name="left_spring_link" pos="-0.0127 -0.012 0.07222" quat="1 -1 0 0">
                      <inertial mass="0.0221642" pos="-0.0183 -0.0205732 0.01205" quat="0.660941 0.660941 -0.251309 -0.251309"
                        diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                      <joint name="left_spring_link_joint" class="grip_spring_link"/>
                      <geom class="grip_visual" pos="0.0127 0.06142 0.01205" quat="1 1 0 0" type="mesh" mesh="grip_spring_link"/>
                      <geom class="grip_collision" pos="0.0127 0.06142 0.01205" quat="1 1 0 0" type="mesh" mesh="grip_spring_link"/>
                      <body name="left_follower" pos="-0.0382079 -0.0425003 0.00295" quat="0 -1 -1.90231e-05 0">
                        <inertial mass="0.0125222" pos="-0.00852976 -0.0014822 -0.00910001" quat="0.359439 0.359439 0.608937 0.608937"
                          diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                        <joint name="left_follower" class="grip_follower"/>
                        <geom class="grip_visual" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" type="mesh" mesh="grip_follower"/>
                        <geom class="grip_visual" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" type="mesh" material="metal" mesh="grip_tongue"/>
                        <geom class="grip_collision" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" type="mesh" mesh="grip_follower"/>
                        <geom class="grip_collision" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" type="mesh" mesh="grip_tongue"/>
                        <body name="left_pad" pos="-0.0377897 -0.103916 -0.0091" quat="1 -1 0 0">
                          <geom class="grip_pad1" name="left_pad1"/>
                          <geom class="grip_pad2" name="left_pad2"/>
                        </body>
                      </body>
                    </body>

                    <!-- Right-hand side 4-bar linkage -->
                    <body name="right_driver" pos="0.0306011 -0.00475 0.0657045" quat="0 0 -1 1">
                      <inertial mass="0.00899563" pos="-0.0175297 0.00165308 -0.00469625" quat="-0.469642 0.469642 -0.528617 0.528617"
                        diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                      <joint name="right_driver_joint" class="grip_driver"/>
                      <geom class="grip_visual" pos="0.0306011 0.0549045 -0.0047" quat="1 1 0 0" material="metal" mesh="grip_driver"/>
                      <geom class="grip_collision" pos="0.0306011 0.0549045 -0.0047" quat="1 1 0 0" mesh="grip_driver"/>
                      <body name="right_coupler" pos="-0.0314249 0.00453223 -0.0102" quat="0 0 0 1">
                        <inertial mass="0.0140974" pos="0.00367747 0.01986 0.0055" quat="0.701447 -0.701447 0.0892884 -0.0892884"
                          diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                        <geom class="grip_visual" pos="-0.062026 -0.0503723 0.0055" quat="1 -1 0 0" mesh="grip_coupler"/>
                        <geom class="grip_collision" pos="-0.062026 -0.0503723 0.0055" quat="1 -1 0 0" mesh="grip_coupler"/>
                      </body>
                    </body>
                    <body name="right_spring_link" pos="0.0127 0.012 0.07222" quat="0 0 -1 1">
                      <inertial mass="0.0221642" pos="-0.0183 -0.0205732 0.01205" quat="0.660941 0.660941 -0.251309 -0.251309"
                        diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                      <joint name="right_spring_link_joint" class="grip_spring_link"/>
                      <geom class="grip_visual" pos="0.0127 0.06142 0.01205" quat="1 1 0 0" mesh="grip_spring_link"/>
                      <geom class="grip_collision" pos="0.0127 0.06142 0.01205" quat="1 1 0 0" mesh="grip_spring_link"/>
                      <body name="right_follower" pos="-0.0382079 -0.0425003 0.00295" quat="0 -1 0 0">
                        <inertial mass="0.0125222" pos="-0.00852976 -0.0014822 -0.00910001" quat="0.359439 0.359439 0.608937 0.608937"
                          diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                        <joint name="right_follower_joint" class="grip_follower"/>
                        <geom class="grip_visual" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" material="metal" mesh="grip_tongue"/>
                        <geom class="grip_visual" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" mesh="grip_follower"/>
                        <geom class="grip_collision" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" mesh="grip_tongue"/>
                        <geom class="grip_collision" pos="0.0509079 -0.10392 -0.0091" quat="1 -1 0 0" mesh="grip_follower"/>
                        <body name="right_pad" pos="-0.0377897 -0.103916 -0.0091" quat="1 -1 0 0">
                          <geom class="grip_pad1" name="right_pad1"/>
                          <geom class="grip_pad2" name="right_pad2"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>

              </body><!-- end link_5 -->
            </body><!-- end link_4 -->
          </body><!-- end link_3 -->
        </body><!-- end link_2 -->
      </body><!-- end link_1 -->
    </body><!-- end base_link -->

    <!-- ══════════════════════════════════════════════════════════
         TABLE — half height, orientation matched to Franka
         ─────────────────────────────────────────────────────────
         Long axis  : along X  (TABLE_HALF_LEN = 0.40 m)
         Short axis : along Y  (TABLE_HALF_WID = 0.30 m)
         Total height: legs 0.16 m + slab 0.02 m = 0.18 m top surface
         Body placed at Y=0.55 so the robot (at origin) can reach it.
         ══════════════════════════════════════════════════════════ -->
    <!--  ▼ TABLE PARAMETRIC BLOCK — edit TABLE_* values here ▼
          TABLE_HALF_LEN = 0.40   → geom size x
          TABLE_HALF_WID = 0.30   → geom size y
          TABLE_HALF_HGT = 0.02   → geom size z  and leg pos z adjust
          TABLE_LEG_HALF = 0.03   → leg geom size x and y
          TABLE_LEG_HEIGHT= 0.16  → leg pos z = LEG_HEIGHT/2, top pos z = LEG_HEIGHT + HGT
          TABLE_BODY_POS  = "0.0 0.55 0"
    -->
    <body name="table" pos="0.0 0.55 0">
      <!-- Top slab:  x=TABLE_HALF_LEN  y=TABLE_HALF_WID  z=TABLE_HALF_HGT
                      pos z = TABLE_LEG_HEIGHT + TABLE_HALF_HGT = 0.16+0.02 = 0.18 -->
      <geom name="table_top" type="box" size="0.40 0.30 0.02"
            pos="0 0 0.18" material="table_mat" mass="20.0"/>
      <!-- Legs: pos x = ±(TABLE_HALF_LEN - TABLE_LEG_HALF) = ±0.37
                 pos y = ±(TABLE_HALF_WID - TABLE_LEG_HALF) = ±0.27
                 pos z = TABLE_LEG_HEIGHT/2 = 0.08
                 size z = TABLE_LEG_HEIGHT/2 = 0.08 -->
      <geom name="leg_fl" type="box" size="0.03 0.03 0.08"
            pos=" 0.37  0.27 0.08" material="leg_mat" mass="1.5"/>
      <geom name="leg_fr" type="box" size="0.03 0.03 0.08"
            pos=" 0.37 -0.27 0.08" material="leg_mat" mass="1.5"/>
      <geom name="leg_bl" type="box" size="0.03 0.03 0.08"
            pos="-0.37  0.27 0.08" material="leg_mat" mass="1.5"/>
      <geom name="leg_br" type="box" size="0.03 0.03 0.08"
            pos="-0.37 -0.27 0.08" material="leg_mat" mass="1.5"/>
    </body>

    <!-- ══════════════════════════════════════════════════════════
         CUBE — default pos at table centre; launcher randomises it
         Cube centre z = TABLE_TOP_Z + CUBE_HALF = 0.18 + 0.02 = 0.20
         ══════════════════════════════════════════════════════════ -->
    <body name="cube" pos="0.0 0.55 0.20">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02"
            material="cube_mat" mass="0.15" condim="4"/>
      <site name="cube_center" size="0.005" rgba="1 1 0 1"/>
    </body>

  </worldbody>

  <!-- Robotiq 2F-85 self-collision excludes, coupling tendon and
       equality constraints; mirrors robot_descriptions/robotiq_2f85_v4/2f85.xml.
       Without these the two fingers are not mechanically coupled and
       the spring-loaded 4-bar linkage will not hold its shape. -->
  <contact>
    <exclude body1="gripper_base" body2="left_driver"/>
    <exclude body1="gripper_base" body2="right_driver"/>
    <exclude body1="gripper_base" body2="left_spring_link"/>
    <exclude body1="gripper_base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.485"/>
      <joint joint="left_driver_joint" coef="0.485"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="-0.0179014 -0.00651468 0.0044" body1="right_follower" body2="right_coupler"
      solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="-0.0179014 -0.00651468 0.0044" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
  </equality>

  <!-- ══════════════════════════════════════════════════════════
       ACTUATORS — position servos so the MuJoCo ctrl sliders act
       as joint-angle setpoints.  The launch script drives ctrl[]
       smoothly via linear interpolation (no PID in Python).
       ══════════════════════════════════════════════════════════ -->
  <actuator>
    <position name="turret"   joint="joint_1" kp="800" kv="80"/>
    <position name="shoulder" joint="joint_2" kp="800" kv="80"/>
    <position name="elbow"    joint="joint_3" kp="800" kv="80"/>
    <position name="wrist_1"  joint="joint_4" kp="400" kv="40"/>
    <position name="wrist_2"  joint="joint_5" kp="400" kv="40"/>
    <position name="wrist_3"  joint="joint_6" kp="400" kv="40"/>
  </actuator>

</mujoco>