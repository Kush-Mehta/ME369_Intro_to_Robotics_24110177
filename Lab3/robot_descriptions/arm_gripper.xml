<mujoco model="addverb_heal">
    <option gravity="0 0 -9.81" />
    <compiler angle="radian" 
    inertiafromgeom="false" 
    discardvisual="false" 
    meshdir="heal_meshes/" />

    <statistic center="0.3 0 0.4" extent="1.5"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
        <material name="black" rgba="0 0 0 1"/>
        <material name="metal" rgba="0.7 0.7 0.7 1" specular="0.5" shininess="1.0"/>
        
        <material name="arm" rgba="0.75294 0.75294 0.75294 0"/>
        
        <mesh name="base_link" file="base_link.STL" />
        <mesh name="link1" file="link_1.STL" />
        <mesh name="link2" file="link_2.STL" />
        <mesh name="link3" file="link_3.STL" />
        <mesh name="link4" file="link_4.STL" />
        <mesh name="link5" file="link_5.STL" />
        <mesh name="end_effector" file="end_effector.STL" />
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
        <camera name="scene_3d_view" pos="1 1 1" zaxis="-0 -1 -1"/>
        
        <!-- Arm -->
        <body name="base_link" pos="0.0 0 0" euler="0 0 0">
            <geom name="base_link_visual" type="mesh" mesh="base_link" group="1" contype="0" conaffinity="0"/>
            <geom name="base_link_collision" type="mesh" mesh="base_link" group="0" contype="0" conaffinity="0" material="arm"/>
            <body name="link_1" pos="0 0 0.171">
                <inertial pos="-12.54E-03 -0.04E-03 111.27E-03" 
                        quat="0.704455 -0.0304055 0.0162858 0.70891" 
                        mass="7.92" diaginertia="0.00490984 0.00426023 0.00389513" />
                <joint name="joint_1" pos="0 0 0" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                <geom name="link_1_visual" type="mesh" mesh="link1" group="1" contype="0" conaffinity="0" material="arm"/>
                <geom name="link_1_collision" type="mesh" mesh="link1" group="0"/>
                
                <body name="link_2" pos="0 0.0875 0.1498" quat="0.707105 0.707108 0 0">
                <inertial pos="-0.00017021 0.1561 -0.016973" 
                            quat="0.499892 0.50026 -0.499813 0.500035" 
                            mass="1.24" diaginertia="0.0097684 0.0086581 0.0014536" />
                <joint name="joint_2" pos="0 0 0" axis="0 0 -1" range="-3.14159 3.14159" damping="55" frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                <geom name="link_2_visual" type="mesh" mesh="link2" group="1" contype="0" conaffinity="0" material="arm"/>
                <geom name="link_2_collision" type="mesh" mesh="link2" group="0"/>
                
                <body name="link_3" pos="0 0.3 0" euler="0 0 -1.57">
                    <inertial pos="-7.5516e-07 0 0.073251" 
                                quat="0.495149 0.509997 -0.506629 0.487912" 
                                mass="5.57" diaginertia="0.0048786 0.00425304 0.00369796" />
                    <joint name="joint_3" pos="0 0 0" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                    <geom name="link_3_visual" type="mesh" mesh="link3" group="1" contype="0" conaffinity="0" material="arm"/>
                    <geom name="link_3_collision" type="mesh" mesh="link3" group="0"/>

                    <body name="link_4" pos="0 0.1593 0.0875" euler="-1.57 0 0">
                        <inertial pos="1.3303e-05 0.06 0.10412" 
                                quat="0.313668 0.63349 -0.634256 0.313086" 
                                mass="1.9" diaginertia="0.00162547 0.0014257 0.00104183" />
                        <joint name="joint_4" pos="0 0 0" axis="0 0 1" range="-3.14159 3.14159" damping="55"  frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                        <geom name="link_4_visual" type="mesh" mesh="link4" group="1" contype="0" conaffinity="0" material="arm"/>
                        <geom name="link_4_collision" type="mesh" mesh="link4" group="0"/>

                        <body name="link_5" pos="0 0.03185 0.16105" euler="0.50951 0 1.57">
                            <inertial pos="-5.6194e-05 -0.046 0.059696" 
                                    quat="0.457117 0.537094 0.438555 0.556994" 
                                    mass="1.78" diaginertia="0.000913478 0.000827593 0.000774169" />
                            <joint name="joint_5" pos="0 0 0" axis="0 0 1" range="-3.14159 3.14159" damping="55"  frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                            <geom name="link_5_visual" type="mesh" mesh="link5" group="1" contype="0" conaffinity="0" material="arm"/>
                            <geom name="link_5_collision" type="mesh" mesh="link5" group="0"/>

                            <body name="end_effector" pos="0 -0.1227 0.0654" quat="0.707105 0.707108 0 0">
                            <body name="right_hand" pos="0.0 0.0 0.0" quat="1 0 0 0">
                                <camera mode="fixed" name="right_eye_in_hand" pos="0.05 0 0" quat="0.5 0.5 -0.5 -0.5" fovy="75"/>
                            </body>
                            <inertial pos="7.0245e-06 -0.00022138 -0.016847" 
                                        quat="-0.0128774 0.707029 0.00995758 0.706998" 
                                        mass="0.001" diaginertia="0.000326122 0.000191249 0.000189678" />
                            <joint name="joint_6" pos="0 0 0" axis="0 0 -1" range="-3.14159 3.14159" damping="55"  frictionloss="0.1" actuatorfrcrange="-10000 10000" />
                            <site name="right_center" pos="0 0 0" size="0.01" rgba="1 0.3 0.3 1" group="1"/>
                            <geom name="end_effector_visual" type="mesh" mesh="end_effector" group="1" contype="0" conaffinity="0" material="arm"/>
                            <geom name="end_effector_collision" type="mesh" mesh="end_effector" group="0"/>
                            </body>

                            <!-- Gripper starts here -->
                            <body name="gripper_base" pos="0 0 0" quat="1 0 0 0">
                                <geom name="gripper_palm" type="box" size="0.04 0.02 0.04" pos="0 0 0.03" material="black" contype="0" conaffinity="0" group="1"/>
                                <geom name="gripper_neck" type="box" size="0.02 0.015 0.015" pos="0 0 0" material="black" contype="0" conaffinity="0" group="1"/>

                                <!-- Left linkage -->
                                <body name="left_driver" pos="-0.0306011 0.00475 0.0657045" quat="1 -1 0 0">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                <joint name="left_driver_joint" range="0 0.9" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
                                <geom type="box" size="0.02 0.01 0.03" material="black" contype="0" conaffinity="0" group="1"/>
                                <body name="left_coupler" pos="-0.0314249 0.00453223 -0.0102">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                    <geom type="box" size="0.015 0.01 0.02" material="black" contype="0" conaffinity="0" group="1"/>
                                </body>
                                </body>

                                <body name="left_spring_link" pos="-0.0127 -0.012 0.07222" quat="1 -1 0 0">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                <joint name="left_spring_link_joint" range="-0.29670597283 0.9" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
                                <geom type="box" size="0.01 0.01 0.04" material="black" contype="0" conaffinity="0" group="1"/>
                                <body name="left_follower" pos="-0.0382079 -0.0425003 0.00295">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                    <joint name="left_follower_joint" range="-0.872664 0.9" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
                                    <geom type="box" size="0.015 0.01 0.025" material="black" contype="0" conaffinity="0" group="1"/>
                                    <geom type="box" size="0.01 0.005 0.02" material="black" contype="0" conaffinity="0" group="1"/>
                                </body>
                                </body>

                                <!-- Right linkage -->
                                <body name="right_driver" pos="0.0306011 -0.00475 0.0657045" quat="0 0 -1 1">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                <joint name="right_driver_joint" range="0 0.9" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
                                <geom type="box" size="0.02 0.01 0.03" material="black" contype="0" conaffinity="0" group="1"/>
                                <body name="right_coupler" pos="-0.0314249 0.00453223 -0.0102">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                    <geom type="box" size="0.015 0.01 0.02" material="black" contype="0" conaffinity="0" group="1"/>
                                </body>
                                </body>

                                <body name="right_spring_link" pos="0.0127 0.012 0.07222" quat="0 0 -1 1">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                <joint name="right_spring_link_joint" range="-0.29670597283 0.9" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
                                <geom type="box" size="0.01 0.01 0.04" material="black" contype="0" conaffinity="0" group="1"/>
                                <body name="right_follower" pos="-0.0382079 -0.0425003 0.00295">
                                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                                    <joint name="right_follower_joint" range="-0.872664 0.9" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
                                    <geom type="box" size="0.015 0.01 0.025" material="black" contype="0" conaffinity="0" group="1"/>
                                    <geom type="box" size="0.01 0.005 0.02" material="black" contype="0" conaffinity="0" group="1"/>
                                </body>
                                </body>
                            </body>
                            <!-- End gripper -->
                        </body>
                    </body>   
                </body>
                </body>
            </body>
        </body>
    </worldbody>

  <contact>
    <exclude body1="gripper_base" body2="left_driver"/>
    <exclude body1="gripper_base" body2="right_driver"/>
    <exclude body1="gripper_base" body2="left_spring_link"/>
    <exclude body1="gripper_base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <!-- Robotiq 2F-85 style coupling: ties the 4-bar linkage together so the
       fingers close/open as a matched parallel-jaw pair instead of sagging
       independently under gravity (this is what caused the old "floating,
       disconnected finger" look). -->
  <tendon>
    <fixed name="gripper_split">
      <joint joint="right_driver_joint" coef="0.485"/>
      <joint joint="left_driver_joint" coef="0.485"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="-0.0179014 -0.00651468 0.0044" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="-0.0179014 -0.00651468 0.0044" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

    <!-- Actuators for Left Arm
         Using position actuators (kp/kv) so the arm holds its pose under
         gravity and the MuJoCo Control sliders work as joint-angle setpoints.
         kp=800 is stiff enough to resist gravity; kv=80 damps oscillation.
    -->
    <actuator>
        <position name="turret"   joint="joint_1" kp="800" kv="80" />
        <position name="shoulder" joint="joint_2" kp="800" kv="80" />
        <position name="elbow"    joint="joint_3" kp="800" kv="80" />
        <position name="wrist_1"  joint="joint_4" kp="400" kv="40" />
        <position name="wrist_2"  joint="joint_5" kp="400" kv="40" />
        <position name="wrist_3"  joint="joint_6" kp="400" kv="40" />
    </actuator>

</mujoco>
